# ─── Supabase ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버(Edge Function)에서만. 클라이언트 금지
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# ─── Anthropic (Edge Function 안에서만) ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6   # 숙제검사=비전. 필요시 조정
# ─── 결제 ───
STRIPE_SECRET_KEY=                  # 과외쌤 앱 구독료(웹)
STRIPE_WEBHOOK_SECRET=
REVENUECAT_API_KEY=                 # 학생 프리미엄 IAP
# ─── 가격(상수와 동기화) ───
PRICE_STUDENT_PREMIUM_KRW=2900
PRICE_PER_STUDENT_KRW=2900          # 과외쌤: active 연결 수 × 이 값
# ─── 앱 ───
STUDENT_APP_SCHEME=ssamplanner
TEACHER_APP_URL=http://localhost:3000
