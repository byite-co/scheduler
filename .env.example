# 루트 .env.local: Supabase CLI 작업용
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# 앱 공개 클라이언트 키: 브라우저/Expo에 노출 가능
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 서버/Edge Function 전용. 레포에 실제 값을 커밋하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Edge Function 시크릿 (Supabase 대시보드/CLI 로 설정. 이 파일은 목록용이다) ──
#
# BROWSER_ALLOWED_ORIGINS — 브라우저에서 Edge Function 을 부를 수 있는 origin 화이트리스트.
#   쉼표로 구분한다. 예: https://app.example.com,http://localhost:3000
#   ⚠️ 오설정 시 영향: **모든 Edge Function 의 브라우저 호출이 CORS 로 막힌다**
#      (숙제 AI 검사·탈퇴가 웹에서 전부 실패). 비워 두면 브라우저 origin 이 하나도 허용되지 않는다.
#      서버-서버 호출(Authorization 헤더만 쓰는 경로)은 영향받지 않아서, 웹만 조용히 깨진다.
#   읽는 곳: supabase/functions/_shared/cors.ts
BROWSER_ALLOWED_ORIGINS=

# AI_OBSERVATION_INCLUDE_SCOPE — 숙제 관찰 프롬프트에 "검사 범위" 문구를 넣을지 여부.
#   'true' 일 때만 포함한다. 미설정이면 넣지 않는다(현재 기본).
#   ⚠️ 오설정 시 영향: 관찰 프롬프트 입력이 바뀌어 **판정 성향이 달라진다**
#      (실험 결과가 과거와 비교 불가능해진다). 값을 바꾸면 그 사실을 기록해야 한다.
#   읽는 곳: supabase/functions/ai-homework-check/index.ts
AI_OBSERVATION_INCLUDE_SCOPE=

# 결제 서버 전용
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# 가격 상수 동기화용
PRICE_STUDENT_PREMIUM_KRW=8900
PRICE_PER_STUDENT_KRW=4900

# 앱 URL/스킴
STUDENT_APP_SCHEME=ssamplanner
TEACHER_APP_URL=http://localhost:3000
