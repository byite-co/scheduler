# 루트 .env.local: Supabase CLI 작업용
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# 앱 공개 클라이언트 키: 브라우저/Expo에 노출 가능
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 서버/Edge Function 전용. 레포에 실제 값을 커밋하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 결제 서버 전용
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# 가격 상수 동기화용
PRICE_STUDENT_PREMIUM_KRW=2900
PRICE_PER_STUDENT_KRW=2900

# 앱 URL/스킴
STUDENT_APP_SCHEME=ssamplanner
TEACHER_APP_URL=http://localhost:3000
