# 과외쌤 웹(Next.js) 환경변수. 이 파일을 `.env.local` 로 복사해 값을 채운다.
#
# ⚠️ 이 두 개가 없으면 화면이 뜨고 나서 Supabase 호출이 전부 실패한다
#    (클라이언트가 지연 생성이라 빌드는 통과한다).
#
# 공개 키다(브라우저에 노출된다). RLS 가 실제 방어선이고 이 키는 신원이 아니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# E2E(Playwright)에서 대상 주소를 바꿀 때만. 비워 두면 로컬 기본값을 쓴다.
E2E_BASE_URL=
