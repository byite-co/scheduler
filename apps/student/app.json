{
  "expo": {
    "name": "쌤플래너 학생",
    "slug": "ssamplanner-student",
    "scheme": "ssamplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "쌤플래너 집중 모드에서 카메라로 졸음 신호를 기기 안에서만 확인합니다."
      }
    },
    "android": {
      "permissions": ["android.permission.CAMERA"]
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
