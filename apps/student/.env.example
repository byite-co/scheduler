# 학생 앱(Expo) 환경변수. 이 파일을 `.env` 로 복사해 값을 채운다.
#
# ⚠️ 이 두 개가 없으면 앱이 **빌드는 통과하고 실행 시점에** 죽는다.
#    (supabaseClient.ts 가 지연 생성이라 CI 의 정적 export 는 성공한다 —
#     그래서 "빌드가 됐으니 설정이 맞다" 로 착각하기 쉽다.)
#    Metro 가 빌드 때 값으로 인라인하므로, 값을 바꾸면 앱을 다시 빌드해야 한다.
#
# 공개 키다(브라우저·기기에 노출된다). RLS 가 실제 방어선이고 이 키는 신원이 아니다.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
