{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@ssamplanner/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@ssamplanner/shared": ["../../packages/shared/src/index.ts"],
      "@ssamplanner/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
